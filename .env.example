# Beds24 の「設定 > アカウント > アクセス」で発行した招待コードを貼り付けてください。
# 一度アプリを起動すると自動的に refreshToken に置き換わり、このファイルに保存されます。
BEDS24_INVITE_CODE=

# 自動生成されるため、通常は手で書き換える必要はありません。
BEDS24_REFRESH_TOKEN=

# AirROI の市場データAPIキー(単価調整タブで使用)
AIRROI_API_KEY=

# PriceLabs Customer API キー(現在はMCP経由の連携がメインで未使用)
PRICELABS_API_KEY=

# ダッシュボードのログインパスワード(スマホ等から共有リンクで見られないようにする簡易認証)
APP_PASSWORD=

# --- 自動返信パイプライン(autoreply/) ---
# console.anthropic.com で発行するAPIキー
ANTHROPIC_API_KEY=

# true にするとFAQ分類の返信を実際に自動送信する。false(デフォルト)はシャドーモード(記録のみ、送信しない)。
AUTO_SEND_ENABLED=false

# 宿泊者名簿フォームの回答シートを読むためのGoogleサービスアカウント(Sheets API)。
# Google Cloud ConsoleでJSONキーを発行し、中身をそのまま1行で貼り付ける。
# (開発時はファイルパスでも可: GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/key.json)
GOOGLE_SERVICE_ACCOUNT_JSON=

# FAQ知識ベース(autoreply/faq_knowledge.json)の中身をそのまま1行で貼り付ける。
# 鍵の暗証番号等を含むため、このファイル自体は公開リポジトリに含めない。
FAQ_KNOWLEDGE_JSON=

# 宿泊者名簿フォームの回答シートID一覧(autoreply/registry_sheets.json)の中身を貼り付ける。
REGISTRY_SHEETS_JSON=

# 処理済みメッセージ・送信済み催促を記録するGoogleスプレッドシート(autoreply/state_sheet.json)の中身を貼り付ける。
# Render等、ディスクが一時的な環境にデプロイする場合は必須。
STATE_SHEET_JSON=

# イレギュラー判定されたメッセージをLINEに通知するためのチャネルアクセストークン。
# LINE Official Account Manager > 設定 > Messaging API で発行する。
LINE_CHANNEL_ACCESS_TOKEN=

